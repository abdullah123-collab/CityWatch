# Application Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
DEBUG=false

# Session Security (Change to a strong random secret key in production)
SECRET_KEY=change-this-secret-key-to-a-random-32-char-string-in-production

# Offline Development & Demo Mode
# When DB_ENABLED=false, the application uses local demo accounts and departments.
DEMO_MODE=true

# Microsoft SQL Server Configuration
# Keep DB_ENABLED=false until database access is authorized and verified.
DB_ENABLED=false
DB_SERVER=your_sql_server_host_or_instance
DB_PORT=1433
DB_DATABASE=CityWatch
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_AUTH=windows
DB_USER=your_dedicated_app_login
DB_PASSWORD=your_secure_password_placeholder
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=true
